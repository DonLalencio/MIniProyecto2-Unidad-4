# La carpeta de archivos solo sirve imágenes: se bloquea la ejecución de scripts.
<FilesMatch "\.(php|php3|php4|php5|php7|phtml|pl|py|cgi|sh|htm|html)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Se fuerza la descarga/visualización como imagen, nunca como código
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
</IfModule>

Options -Indexes
